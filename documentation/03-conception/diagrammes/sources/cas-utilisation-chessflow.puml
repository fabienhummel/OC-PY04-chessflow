@startuml
title ChessFlow — Diagramme de cas d'utilisation (version livrée)

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam actor {
  BackgroundColor #E8F1FA
  BorderColor #24527A
  FontColor #17324D
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #3D5A73
  FontColor #1F2937
}

actor "Organisateur du tournoi" as Organizer

rectangle "ChessFlow" {
  package "Registre des joueurs" {
    usecase "Ajouter un joueur" as UC_AddPlayer
    usecase "Lister les joueurs" as UC_ListPlayers
    usecase "Rechercher un joueur" as UC_SearchPlayer
    usecase "Modifier un joueur" as UC_EditPlayer
    usecase "Supprimer un joueur" as UC_DeletePlayer
  }

  package "Gestion du tournoi" {
    usecase "Créer un tournoi" as UC_CreateTournament
    usecase "Lister les tournois\nenregistrés" as UC_ListTournamentFiles
    usecase "Charger un tournoi" as UC_LoadTournament
    usecase "Lister les participants" as UC_ListTournamentPlayers
    usecase "Ajouter un participant\navant Round 1" as UC_AddTournamentPlayer
    usecase "Lister les rondes" as UC_ListRounds
    usecase "Créer la ronde suivante" as UC_CreateRound
    usecase "Générer les appariements" as UC_Pairings
    usecase "Saisir ou modifier\nun résultat" as UC_Results
    usecase "Clôturer la ronde\nen cours" as UC_CloseRound
    usecase "Afficher le classement" as UC_Ranking
  }

  package "Rapports" {
    usecase "Rapport des joueurs" as UC_ReportPlayers
    usecase "Rapport des tournois" as UC_ReportTournaments
    usecase "Détail d'un tournoi" as UC_ReportDetails
    usecase "Participants d'un tournoi" as UC_ReportTournamentPlayers
    usecase "Rondes et matchs" as UC_ReportRounds
    usecase "Classement d'un tournoi" as UC_ReportRanking
  }

  usecase "Sauvegarder les\ndonnées validées" as UC_Save
}

Organizer --> UC_AddPlayer
Organizer --> UC_ListPlayers
Organizer --> UC_SearchPlayer
Organizer --> UC_EditPlayer
Organizer --> UC_DeletePlayer

Organizer --> UC_CreateTournament
Organizer --> UC_ListTournamentFiles
Organizer --> UC_LoadTournament
Organizer --> UC_ListTournamentPlayers
Organizer --> UC_AddTournamentPlayer
Organizer --> UC_ListRounds
Organizer --> UC_CreateRound
Organizer --> UC_Results
Organizer --> UC_CloseRound
Organizer --> UC_Ranking

Organizer --> UC_ReportPlayers
Organizer --> UC_ReportTournaments
Organizer --> UC_ReportDetails
Organizer --> UC_ReportTournamentPlayers
Organizer --> UC_ReportRounds
Organizer --> UC_ReportRanking

UC_CreateRound .> UC_Pairings : <<include>>

UC_AddPlayer .> UC_Save : <<include>>
UC_EditPlayer .> UC_Save : <<include>>
UC_DeletePlayer .> UC_Save : <<include>>
UC_CreateTournament .> UC_Save : <<include>>
UC_AddTournamentPlayer .> UC_Save : <<include>>
UC_CreateRound .> UC_Save : <<include>>
UC_Results .> UC_Save : <<include>>
UC_CloseRound .> UC_Save : <<include>>

note bottom of UC_AddTournamentPlayer
  L'ajout de participants est interdit
  après la création de Round 1.
end note

note bottom of UC_CreateRound
  Nombre de participants pair.
  Première ronde : mélange aléatoire.
  Rondes suivantes : score décroissant,
  revanche évitée autant que possible.
end note

note bottom of UC_Ranking
  Les scores sont calculés dynamiquement
  depuis les résultats des matchs.
end note
@enduml
